  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NOOP reads your heart rate from the Watch sensor to show a live readout on your wrist. It stays on your device."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP legge il battito dal sensore del Watch per mostrarlo in tempo reale al polso. Resta sul tuo dispositivo."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NOOP records a basic workout session on your Watch for a higher-fidelity heart rate. The session stays on your device."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP registra una semplice sessione di allenamento sul Watch per un battito più preciso. La sessione resta sul tuo dispositivo."
          }
        }
      }
    }
  },
  "version" : "1.0"
