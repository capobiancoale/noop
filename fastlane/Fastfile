# NOOP browser build — build the iOS app (+ widgets, Apple Watch app and complication) on GitHub
# Actions and deliver it to TestFlight, with no Mac and no Xcode on your side.
#
# Adapted from LoopKit/LoopWorkspace's fastlane setup (the "Loop browser build"). What differs for NOOP:
#   • NOOP has no committed .xcodeproj — it is generated by XcodeGen from project.yml. The build lane
#     generates it from a TEMPORARY copy of project.yml (project.ci.yml) with your team's bundle prefix,
#     your Team ID and the next TestFlight build number baked in. project.yml itself is never modified.
#   • Every identifier is namespaced by your Team ID (com.<TEAMID>.noopapp.noop …), like Loop's
#     com.<TEAMID>.loopkit.Loop, so the ids are globally unique under your own Apple Developer team.
#   • Before archiving, the downloaded profiles are checked for the App Group, so a missed manual step
#     fails in seconds with a plain instruction instead of a cryptic signing error 20 minutes in.
#
# Setup and the order to run the workflows: fastlane/BROWSER_BUILD.md

require "base64"
require "plist"

default_platform(:ios)

TEAMID = ENV["TEAMID"].to_s.strip
GH_PAT = ENV["GH_PAT"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

# Repository root (GitHub Actions sets GITHUB_WORKSPACE; locally, the folder above fastlane/).
ROOT = ENV["GITHUB_WORKSPACE"].to_s.empty? ? File.expand_path("..", FastlaneCore::FastlaneFolder.path) : ENV["GITHUB_WORKSPACE"]
SPEC = File.join(ROOT, "project.yml")
CI_SPEC = File.join(ROOT, "project.ci.yml")
PROJECT = File.join(ROOT, "Strand.xcodeproj") # XcodeGen names it after `name: Strand` in project.yml
SCHEME = "NOOPiOS"
IPA = File.join(ROOT, "NOOP.ipa")

BUNDLE_PREFIX = "com.#{TEAMID}.noopapp"
APP_ID = "#{BUNDLE_PREFIX}.noop"
APP_GROUP = "group.#{BUNDLE_PREFIX}.noop"

# Xcode target => bundle identifier. Must mirror project.yml ($(NOOP_BUNDLE_PREFIX).noop…).
TARGETS = {
  "NOOPiOS" => APP_ID,
  "NOOPiOSWidgets" => "#{APP_ID}.widgets",
  "NOOPWatch" => "#{APP_ID}.watch",
  "NOOPWatchComplications" => "#{APP_ID}.watch.complications",
}
APP_IDENTIFIERS = TARGETS.values

def ensure_team!
  UI.user_error!("The TEAMID secret is empty. Add your 10-character Apple Team ID as a repository secret.") if TEAMID.empty?
end

def noop_api_key
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID,
    issuer_id: FASTLANE_ISSUER_ID,
    key_content: FASTLANE_KEY
  )
end

def match_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

platform :ios do
  desc "Generate Strand.xcodeproj for your team (temporary spec; project.yml is left untouched)"
  private_lane :generate_project do |options|
    build_number = options[:build_number]
    spec = File.read(SPEC)
    [
      [/^([ \t]*)NOOP_BUNDLE_PREFIX: com\.noopapp[ \t]*$/, "\\1NOOP_BUNDLE_PREFIX: #{BUNDLE_PREFIX}"],
      [/^([ \t]*)DEVELOPMENT_TEAM: ""[ \t]*$/, "\\1DEVELOPMENT_TEAM: \"#{TEAMID}\""],
      [/^([ \t]*)CURRENT_PROJECT_VERSION: "\d+"[ \t]*$/, "\\1CURRENT_PROJECT_VERSION: \"#{build_number}\""],
    ].each do |pattern, replacement|
      found = spec.scan(pattern).length
      UI.user_error!("project.yml: expected exactly one line matching #{pattern.source}, found #{found}") unless found == 1
      spec = spec.sub(pattern, replacement)
    end
    File.write(CI_SPEC, spec)
    begin
      sh("xcodegen", "generate", "--spec", CI_SPEC)
    ensure
      File.delete(CI_SPEC) if File.exist?(CI_SPEC)
    end
  end

  desc "Fail fast, with a clear instruction, if a profile is missing the App Group"
  private_lane :verify_app_group do
    missing = []
    TARGETS.each do |target, identifier|
      path = ENV["sigh_#{identifier}_appstore_profile-path"]
      UI.user_error!("No App Store provisioning profile found for #{identifier}. Run '3. Create Certificates'.") if path.to_s.empty? || !File.exist?(path)
      decoded = `security cms -D -i "#{path}" 2>/dev/null`
      entitlements = (Plist.parse_xml(decoded) || {})["Entitlements"] || {}
      groups = Array(entitlements["com.apple.security.application-groups"])
      missing << "#{target} (#{identifier})" unless groups.include?(APP_GROUP)
    end
    unless missing.empty?
      UI.user_error!(
        "The App Group #{APP_GROUP} is not enabled on: #{missing.join(', ')}.\n" \
        "On developer.apple.com → Identifiers: create that App Group (if it doesn't exist), then open each " \
        "identifier above → App Groups → Configure → tick #{APP_GROUP} → Save. Then run '3. Create " \
        "Certificates' and re-run this build. If it still fails, delete the four 'match AppStore " \
        "#{APP_ID}…' profiles under developer.apple.com → Profiles first, so they are recreated with the " \
        "App Group. See fastlane/BROWSER_BUILD.md, step 7 and Troubleshooting."
      )
    end
    UI.success("App Group #{APP_GROUP} is present on all #{TARGETS.size} profiles.")
  end

  desc "Build NOOP (signed .ipa)"
  lane :build_noop do
    setup_ci if ENV["CI"]
    ensure_team!

    api_key = noop_api_key

    previous_build_number = begin
      latest_testflight_build_number(app_identifier: APP_ID, api_key: api_key, initial_build_number: 0)
    rescue => e
      UI.user_error!(
        "Could not read TestFlight builds for #{APP_ID} (#{e.message}).\n" \
        "Create the app in App Store Connect first — My Apps → + → New App, bundle ID #{APP_ID}. " \
        "See fastlane/BROWSER_BUILD.md, step 8."
      )
    end
    build_number = previous_build_number.to_i + 1
    UI.message("Building #{APP_ID}, TestFlight build #{build_number}")

    generate_project(build_number: build_number)

    match(
      type: "appstore",
      git_basic_authorization: match_auth,
      app_identifier: APP_IDENTIFIERS
    )

    verify_app_group

    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    TARGETS.each do |target, identifier|
      profile = mapping[identifier]
      UI.user_error!("match returned no profile for #{identifier}") if profile.to_s.empty?
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: TEAMID,
        targets: [target],
        code_sign_identity: "iPhone Distribution",
        profile_name: profile
      )
    end

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      output_directory: ROOT,
      output_name: File.basename(IPA),
      buildlog_path: File.join(ROOT, "buildlog"),
      export_options: { provisioningProfiles: mapping }
    )
  end

  desc "Push to TestFlight"
  lane :release do
    ensure_team!
    api_key = noop_api_key

    upload_to_testflight(
      api_key: api_key,
      ipa: IPA,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Register the four NOOP identifiers and their capabilities"
  lane :identifiers do
    setup_ci if ENV["CI"]
    ensure_team!
    ENV["MATCH_READONLY"] = false.to_s

    noop_api_key

    cap = Spaceship::ConnectAPI::BundleIdCapability::Type

    def configure_bundle_id(name, identifier, capabilities)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name:       name,
        identifier: identifier,
        platform:   "IOS"
      )
      existing = bundle_id.get_capabilities.map(&:capability_type)
      capabilities.reject { |c| existing.include?(c) }.each do |c|
        bundle_id.create_capability(c)
      end
      UI.success("#{identifier} ready (#{capabilities.empty? ? 'no capabilities' : capabilities.join(', ')})")
    end

    configure_bundle_id("NOOP", APP_ID, [cap::APP_GROUPS, cap::HEALTHKIT])
    configure_bundle_id("NOOP Widgets", "#{APP_ID}.widgets", [cap::APP_GROUPS])
    configure_bundle_id("NOOP Watch", "#{APP_ID}.watch", [cap::APP_GROUPS, cap::HEALTHKIT])
    configure_bundle_id("NOOP Watch Complications", "#{APP_ID}.watch.complications", [cap::APP_GROUPS])

    UI.important("Next, once, by hand on developer.apple.com: create the App Group #{APP_GROUP} and tick it on all " \
                 "four identifiers (App Store Connect's API can't do this). See fastlane/BROWSER_BUILD.md, step 7.")
  end

  desc "Provision Certificates"
  lane :certs do
    setup_ci if ENV["CI"]
    ensure_team!
    ENV["MATCH_READONLY"] = false.to_s

    noop_api_key

    match(
      type: "appstore",
      force: false,
      verbose: true,
      git_basic_authorization: match_auth,
      app_identifier: APP_IDENTIFIERS
    )
  end

  desc "Validate Secrets"
  lane :validate_secrets do
    setup_ci if ENV["CI"]
    ensure_team!
    ENV["MATCH_READONLY"] = true.to_s

    noop_api_key

    Spaceship::ConnectAPI::BundleId.find(APP_ID)

    match(
      type: "appstore",
      git_basic_authorization: match_auth,
      app_identifier: []
    )
  end

  desc "Nuke Certs"
  lane :nuke_certs do
    setup_ci if ENV["CI"]
    ensure_team!
    ENV["MATCH_READONLY"] = false.to_s

    noop_api_key

    match_nuke(
      type: "appstore",
      team_id: TEAMID,
      skip_confirmation: true,
      git_basic_authorization: match_auth
    )
  end

  desc "Check Certificates and flag Expired or Missing Certificates"
  lane :check_and_renew_certificates do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s

    noop_api_key

    new_certificate_needed = false
    distribution_certs = Spaceship::ConnectAPI::Certificate.all.select { |cert| cert.certificate_type == "DISTRIBUTION" }

    if distribution_certs.empty?
      puts "No Distribution certificates found! Flagging for creation."
      new_certificate_needed = true
    else
      distribution_certs.each do |cert|
        expiration_date = Time.parse(cert.expiration_date)
        puts "Distribution Certificate #{cert.id}, expires #{expiration_date}"
        if expiration_date < Time.now
          puts "Distribution Certificate #{cert.id} is expired! Flagging for renewal."
          new_certificate_needed = true
        end
      end
    end

    # Read by the '3. Create Certificates' workflow (fastlane/new_certificate_needed.txt).
    file_path = File.join(ROOT, "fastlane", "new_certificate_needed.txt")
    File.write(file_path, new_certificate_needed ? "true" : "false")
    puts "Certificate creation or renewal needed: #{File.read(file_path)}"
  end
end
